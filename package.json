{
  "name": "nanda-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "dev": "react-router dev",
    "preview": "npm run build && vite preview",
    "typecheck": "react-router typegen && tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply myportfoliodb --local",
    "db:migrate:remote": "wrangler d1 migrations apply myportfoliodb --remote",
    "db:seed:local": "wrangler d1 execute myportfoliodb --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute myportfoliodb --remote --file=./migrations/0002_seed.sql",
    "resume:docx": "node scripts/build-resume-docx.mjs",
    "og:image": "node scripts/build-og-image.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.17",
    "lucide-react": "^0.469.0",
    "marked": "^18.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@react-router/dev": "^7.5.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "docx": "^9.1.1",
    "satori": "^0.26.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.0.0"
  }
}
